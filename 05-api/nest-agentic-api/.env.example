PORT=3003
# 127.0.0.1 = solo esta máquina. Si expones en red, define API_KEY.
HOST=127.0.0.1
# Si se define, todos los endpoints (salvo health/dashboard) exigen header x-api-key.
# Dashboard: abre /factory/dashboard?key=<API_KEY> una vez.
API_KEY=
PERSISTENCE=memory

AGENT_ADAPTER=opencode-cli
# Relativo a ./work-directory (vacío = ./work-directory). Rutas fuera se rechazan.
OPENCODE_WORKSPACE=
# Mata el proceso de OpenCode si excede este tiempo (default 30 min).
OPENCODE_TIMEOUT_MS=1800000
OPENCODE_MODEL=
OPENCODE_SYSTEM_PROMPT=
OPENCODE_DEBUG=1
OPENCODE_THINKING=0

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agentic_factory
DB_SYNCHRONIZE=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

QUEUE_ENABLED=false
QUEUE_CONCURRENCY=1

# Crea/clona el repo de la tarea con la sesión de `gh` y hace push al terminar.
GITHUB_ENABLED=true
# El agente puede usar git/gh con la sesion de gh de esta maquina (solo tareas de confianza).
AGENT_GIT_ACCESS=true

# Login de la interfaz /factory/app. Genera los valores con:
#   pnpm run hash-password -- "tu-contrasena"
APP_USERNAME=
APP_PASSWORD_HASH=
SESSION_SECRET=
# true si sirves la API por HTTPS (cookie Secure)
COOKIE_SECURE=false
# Dueno por defecto de los repos (vacio = usuario de la sesion de gh)
GITHUB_OWNER=
