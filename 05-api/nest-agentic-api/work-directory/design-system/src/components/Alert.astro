---
interface Props {
  variant?: "info" | "success" | "warning" | "danger";
  title: string;
}

const { variant = "info", title } = Astro.props;

const icons: Record<string, string> = {
  info: "M12 16v-5M12 8h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  success: "M20 6 9 17l-5-5",
  warning: "M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z",
  danger: "M15 9l-6 6m0-6 6 6M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
};
---

<div class:list={["ds-alert", `ds-alert--${variant}`]} role="status">
  <svg
    class="ds-alert__icon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={icons[variant]}></path>
  </svg>
  <div class="ds-alert__content">
    <p class="ds-alert__title">{title}</p>
    <div class="ds-alert__text">
      <slot />
    </div>
  </div>
</div>

<style>
  .ds-alert {
    --_bg: var(--ds-color-info-soft);
    --_fg: var(--ds-color-info);
    --_border: color-mix(in srgb, var(--ds-color-info) 30%, transparent);

    display: flex;
    gap: var(--ds-space-3);
    padding: var(--ds-space-4);
    border-radius: var(--ds-radius-md);
    background: var(--_bg);
    border: 1px solid var(--_border);
    color: var(--_fg);
    font-size: var(--ds-text-sm);
  }

  .ds-alert__icon {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .ds-alert__content {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-1);
  }

  .ds-alert__title {
    font-weight: var(--ds-weight-semibold);
    color: var(--ds-color-text);
  }

  .ds-alert__text {
    color: var(--ds-color-text-secondary);
    line-height: var(--ds-leading-snug);
  }

  .ds-alert--success {
    --_bg: var(--ds-color-success-soft);
    --_fg: var(--ds-color-success);
    --_border: color-mix(in srgb, var(--ds-color-success) 30%, transparent);
  }
  .ds-alert--warning {
    --_bg: var(--ds-color-warning-soft);
    --_fg: var(--ds-color-warning);
    --_border: color-mix(in srgb, var(--ds-color-warning) 32%, transparent);
  }
  .ds-alert--danger {
    --_bg: var(--ds-color-danger-soft);
    --_fg: var(--ds-color-danger);
    --_border: color-mix(in srgb, var(--ds-color-danger) 30%, transparent);
  }
</style>
