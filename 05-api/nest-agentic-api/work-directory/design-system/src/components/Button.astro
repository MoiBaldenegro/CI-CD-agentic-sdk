---
interface Props {
  variant?: "primary" | "secondary" | "ghost" | "danger" | "soft";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit" | "reset";
  full?: boolean;
  disabled?: boolean;
  iconOnly?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  full = false,
  disabled = false,
  iconOnly = false,
  class: className = "",
  ...rest
} = Astro.props;

delete rest.slot;

const classes = [
  "ds-btn",
  `ds-btn--${variant}`,
  `ds-btn--${size}`,
  full ? "ds-btn--full" : "",
  iconOnly ? "ds-btn--icon" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

{
  href ? (
    <a href={href} class={classes} aria-disabled={disabled ? "true" : undefined} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} {...rest}>
      <slot />
    </button>
  )
}

<style>
  .ds-btn {
    --_bg: var(--ds-color-surface);
    --_fg: var(--ds-color-text);
    --_border: var(--ds-color-border-strong);
    --_hover-bg: var(--ds-color-surface-sunken);
    --_shadow: var(--ds-shadow-xs);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--ds-space-2);
    font-weight: var(--ds-weight-medium);
    line-height: 1;
    white-space: nowrap;
    border: 1px solid var(--_border);
    border-radius: var(--ds-radius-md);
    background: var(--_bg);
    color: var(--_fg);
    box-shadow: var(--_shadow);
    transition: background-color var(--ds-duration-fast) var(--ds-ease-standard),
      border-color var(--ds-duration-fast) var(--ds-ease-standard),
      color var(--ds-duration-fast) var(--ds-ease-standard),
      transform var(--ds-duration-fast) var(--ds-ease-standard),
      box-shadow var(--ds-duration-fast) var(--ds-ease-standard);
    text-decoration: none;
    user-select: none;
  }

  .ds-btn:hover {
    background: var(--_hover-bg);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .ds-btn:active {
    transform: translateY(0) scale(0.985);
  }

  .ds-btn:disabled,
  .ds-btn[aria-disabled="true"] {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  /* Tamaños */
  .ds-btn--sm {
    font-size: var(--ds-text-sm);
    padding: 0.4rem 0.7rem;
    border-radius: var(--ds-radius-sm);
  }
  .ds-btn--md {
    font-size: var(--ds-text-sm);
    padding: 0.6rem 1rem;
  }
  .ds-btn--lg {
    font-size: var(--ds-text-base);
    padding: 0.8rem 1.35rem;
    border-radius: var(--ds-radius-lg);
  }
  .ds-btn--icon {
    padding: 0.6rem;
    aspect-ratio: 1;
  }
  .ds-btn--full {
    width: 100%;
  }

  /* Variantes */
  .ds-btn--primary {
    --_bg: var(--ds-color-primary);
    --_fg: var(--ds-color-primary-contrast);
    --_border: transparent;
    --_hover-bg: var(--ds-color-primary-hover);
    --_shadow: 0 6px 16px -6px rgba(106, 61, 240, 0.55);
  }
  .ds-btn--secondary {
    --_bg: var(--ds-color-surface);
    --_fg: var(--ds-color-text);
    --_border: var(--ds-color-border-strong);
    --_hover-bg: var(--ds-color-surface-sunken);
  }
  .ds-btn--ghost {
    --_bg: transparent;
    --_fg: var(--ds-color-text-secondary);
    --_border: transparent;
    --_hover-bg: var(--ds-color-surface-sunken);
    --_shadow: none;
  }
  .ds-btn--ghost:hover {
    color: var(--ds-color-text);
  }
  .ds-btn--soft {
    --_bg: var(--ds-color-primary-soft);
    --_fg: var(--ds-color-primary);
    --_border: transparent;
    --_hover-bg: var(--ds-color-primary-soft);
    --_shadow: none;
  }
  .ds-btn--danger {
    --_bg: var(--ds-color-danger);
    --_fg: #ffffff;
    --_border: transparent;
    --_hover-bg: var(--ds-red-800);
    --_shadow: 0 6px 16px -8px rgba(220, 38, 38, 0.6);
  }
</style>
