---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";

const scale = [
  { token: "--ds-text-6xl", name: "Display", size: "3.75rem", px: "60 px", weight: 700, leading: 1.04, sample: "Aurora" },
  { token: "--ds-text-5xl", name: "H1", size: "3rem", px: "48 px", weight: 700, leading: 1.08, sample: "Diseñar con sistema" },
  { token: "--ds-text-4xl", name: "H2", size: "2.25rem", px: "36 px", weight: 600, leading: 1.15, sample: "Fundamentos de marca" },
  { token: "--ds-text-3xl", name: "H3", size: "1.875rem", px: "30 px", weight: 600, leading: 1.2, sample: "Componentes de producto" },
  { token: "--ds-text-2xl", name: "H4", size: "1.5rem", px: "24 px", weight: 600, leading: 1.25, sample: "Panel de ingresos" },
  { token: "--ds-text-xl", name: "Lead", size: "1.25rem", px: "20 px", weight: 400, leading: 1.5, sample: "Un lenguaje visual compartido por todos los equipos." },
  { token: "--ds-text-lg", name: "Body large", size: "1.125rem", px: "18 px", weight: 400, leading: 1.6, sample: "Los tokens permiten cambiar la marca sin tocar componentes." },
  { token: "--ds-text-base", name: "Body", size: "1rem", px: "16 px", weight: 400, leading: 1.6, sample: "El texto base se usa en la mayor parte del contenido." },
  { token: "--ds-text-sm", name: "Small", size: "0.875rem", px: "14 px", weight: 400, leading: 1.55, sample: "Etiquetas, ayudas y metadatos de interfaz." },
  { token: "--ds-text-xs", name: "Caption", size: "0.75rem", px: "12 px", weight: 500, leading: 1.45, sample: "Actualizado hace 2 minutos" },
  { token: "--ds-text-2xs", name: "Overline", size: "0.6875rem", px: "11 px", weight: 600, leading: 1.4, sample: "Fundamentos" },
];
---

<Base title="Tipografía" showToc>
  <PageHeader
    eyebrow="Fundamentos"
    title="Tipografía"
    lead="Inter para interfaz y texto; JetBrains Mono para datos técnicos. Una escala modular con tracking decreciente en titulares y cifras tabulares en métricas."
    meta={["2 familias", "11 pasos de escala", "3 pesos base"]}
  />

  <section class="block">
    <h2>Familias</h2>
    <div class="ds-grid ds-grid--2">
      <div class="family">
        <div class="family__head">
          <div>
            <p class="family__name">Inter Variable</p>
            <code>--ds-font-sans</code>
          </div>
          <span class="family__tag">Interfaz</span>
        </div>
        <p class="family__sample family__sample--sans">
          Aa Bb Cc Dd Ee Ff Gg 0123456789
        </p>
        <p class="family__body">
          Diseñada para pantallas. Usa <code>font-feature-settings</code> por defecto, incluye
          numerales tabulares y un alto rendimiento en cuerpos pequeños.
        </p>
      </div>

      <div class="family">
        <div class="family__head">
          <div>
            <p class="family__name">JetBrains Mono</p>
            <code>--ds-font-mono</code>
          </div>
          <span class="family__tag">Código y datos</span>
        </div>
        <p class="family__sample family__sample--mono">
          Aa Bb Cc → {} =&gt; 0123456789
        </p>
        <p class="family__body">
          Para tokens, fragmentos de código, IDs y valores numéricos que deben alinearse en
          columnas.
        </p>
      </div>
    </div>
  </section>

  <section class="block">
    <h2>Escala tipográfica</h2>
    <p class="ds-muted block__lead">
      La escala se basa en una proporción modular cercana a 1,2. Cada paso tiene su token y se
      consume siempre a través de él.
    </p>

    <div class="scale">
      {
        scale.map((row) => (
          <div class="scale__row">
            <div class="scale__meta">
              <strong>{row.name}</strong>
              <code>{row.token}</code>
              <span class="scale__spec">
                {row.px} · {row.weight} · {row.leading}
              </span>
            </div>
            <p
              class="scale__sample"
              style={`font-size:${row.size};font-weight:${row.weight};line-height:${row.leading};letter-spacing:${
                row.px === "60 px" || row.px === "48 px" ? "-0.035em" : row.px === "11 px" ? "0.08em" : "-0.01em"
              };${row.px === "11 px" ? "text-transform:uppercase;" : ""}`}
            >
              {row.sample}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="block">
    <h2>Pesos</h2>
    <div class="weights">
      <div class="weight">
        <span class="weight__name">Regular</span>
        <span class="weight__value">400</span>
        <p style="font-weight:400">Texto de cuerpo y contenido largo.</p>
      </div>
      <div class="weight">
        <span class="weight__name">Medium</span>
        <span class="weight__value">500</span>
        <p style="font-weight:500">Controles, etiquetas y énfasis puntual.</p>
      </div>
      <div class="weight">
        <span class="weight__name">Semibold</span>
        <span class="weight__value">600</span>
        <p style="font-weight:600">Títulos de sección y encabezados de tabla.</p>
      </div>
      <div class="weight">
        <span class="weight__name">Bold</span>
        <span class="weight__value">700</span>
        <p style="font-weight:700">Solo display y hero. Nunca en cuerpo.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <h2>Reglas de composición</h2>
    <div class="rules">
      <div class="rule">
        <span class="rule__num">01</span>
        <div>
          <h3>Ancho de línea</h3>
          <p>Entre 55 y 75 caracteres por línea. En textos largos limita a <code>65ch</code>.</p>
        </div>
      </div>
      <div class="rule">
        <span class="rule__num">02</span>
        <div>
          <h3>Jerarquía sin saltos</h3>
          <p>No saltes de H2 a H4. La estructura de encabezados refleja el contenido, no el tamaño visual.</p>
        </div>
      </div>
      <div class="rule">
        <span class="rule__num">03</span>
        <div>
          <h3>Cifras tabulares</h3>
          <p>En tablas, KPIs y gráficos usa <code>font-variant-numeric: tabular-nums</code> para alinear columnas.</p>
        </div>
      </div>
      <div class="rule">
        <span class="rule__num">04</span>
        <div>
          <h3>Tracking negativo solo en grande</h3>
          <p>Aplica <code>-0.02em</code> o más a partir de 24 px. En cuerpos pequeños, mantén el tracking natural.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .block {
    padding-block: var(--ds-space-8);
    border-bottom: 1px solid var(--ds-color-border);
  }
  .block:last-child {
    border-bottom: 0;
  }
  .block h2 {
    font-size: var(--ds-text-2xl);
    margin-bottom: var(--ds-space-2);
  }
  .block__lead {
    max-width: 44rem;
    font-size: var(--ds-text-sm);
    margin-bottom: var(--ds-space-5);
  }

  .family {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-3);
    padding: var(--ds-space-5);
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-lg);
    background: var(--ds-color-surface);
  }
  .family__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--ds-space-3);
  }
  .family__name {
    font-weight: var(--ds-weight-semibold);
    font-size: var(--ds-text-sm);
  }
  .family__head code {
    font-family: var(--ds-font-mono);
    font-size: var(--ds-text-2xs);
    color: var(--ds-color-text-muted);
  }
  .family__tag {
    font-size: var(--ds-text-2xs);
    color: var(--ds-color-primary);
    background: var(--ds-color-primary-soft);
    padding: 0.2rem 0.5rem;
    border-radius: var(--ds-radius-full);
    white-space: nowrap;
  }
  .family__sample {
    font-size: 1.6rem;
    line-height: 1.3;
    color: var(--ds-color-text);
    border-top: 1px solid var(--ds-color-border);
    border-bottom: 1px solid var(--ds-color-border);
    padding-block: var(--ds-space-4);
  }
  .family__sample--sans {
    font-family: var(--ds-font-sans);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .family__sample--mono {
    font-family: var(--ds-font-mono);
    font-weight: 500;
  }
  .family__body {
    font-size: var(--ds-text-sm);
    color: var(--ds-color-text-secondary);
    line-height: var(--ds-leading-normal);
  }
  .family__body code {
    font-family: var(--ds-font-mono);
    font-size: 0.85em;
    color: var(--ds-color-text);
  }

  .scale {
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-lg);
    overflow: hidden;
    background: var(--ds-color-surface);
  }
  .scale__row {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: var(--ds-space-6);
    align-items: baseline;
    padding: var(--ds-space-4) var(--ds-space-5);
    border-bottom: 1px solid var(--ds-color-border);
  }
  .scale__row:last-child {
    border-bottom: 0;
  }
  .scale__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .scale__meta strong {
    font-size: var(--ds-text-xs);
    font-weight: var(--ds-weight-semibold);
  }
  .scale__meta code {
    font-family: var(--ds-font-mono);
    font-size: var(--ds-text-2xs);
    color: var(--ds-color-primary);
    overflow-wrap: anywhere;
  }
  .scale__spec {
    font-size: var(--ds-text-2xs);
    color: var(--ds-color-text-muted);
  }
  .scale__sample {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .weights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--ds-space-4);
  }
  .weight {
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-1);
    padding: var(--ds-space-4);
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-md);
    background: var(--ds-color-surface);
  }
  .weight__name {
    font-size: var(--ds-text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--ds-tracking-wide);
    color: var(--ds-color-text-muted);
    font-weight: var(--ds-weight-semibold);
  }
  .weight__value {
    font-family: var(--ds-font-mono);
    font-size: var(--ds-text-xs);
    color: var(--ds-color-primary);
  }
  .weight p {
    font-size: var(--ds-text-sm);
    color: var(--ds-color-text-secondary);
    margin-top: var(--ds-space-1);
  }

  .rules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--ds-space-4);
  }
  .rule {
    display: flex;
    gap: var(--ds-space-4);
    padding: var(--ds-space-4);
    border: 1px solid var(--ds-color-border);
    border-radius: var(--ds-radius-md);
    background: var(--ds-color-surface);
  }
  .rule__num {
    font-family: var(--ds-font-mono);
    font-size: var(--ds-text-xs);
    color: var(--ds-color-primary);
    padding-top: 0.15rem;
  }
  .rule h3 {
    font-size: var(--ds-text-sm);
    font-weight: var(--ds-weight-semibold);
    margin-bottom: var(--ds-space-1);
  }
  .rule p {
    font-size: var(--ds-text-sm);
    color: var(--ds-color-text-secondary);
    line-height: var(--ds-leading-snug);
  }
  .rule code {
    font-family: var(--ds-font-mono);
    font-size: 0.85em;
    padding: 0.1em 0.3em;
    border-radius: var(--ds-radius-xs);
    background: var(--ds-color-surface-sunken);
  }

  @media (max-width: 720px) {
    .scale__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--ds-space-2);
    }
  }
</style>
